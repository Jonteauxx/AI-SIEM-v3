# ============================================================================
# AI-SIEM v3 - Environment Configuration
# ============================================================================
# Copy this file to .env and customize values for your deployment
# IMPORTANT: Never commit .env to version control!

# ============================================================================
# Network Configuration
# ============================================================================
API_PORT=8000
LISTEN_PORT=5046
HOST_IP=0.0.0.0

# ============================================================================
# Database Configuration
# ============================================================================
DB_NAME=ai_agent_logs.db

# ============================================================================
# Elasticsearch/OpenSearch Configuration
# ============================================================================
ES_HOSTS=http://localhost:9200
ES_INDEX=ai-analyzed-logs
OPENSEARCH_PORT=9200

# ============================================================================
# Ollama LLM Configuration
# ============================================================================
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral:7b
OLLAMA_PORT=11434

# ============================================================================
# Processing Configuration
# ============================================================================
BATCH_SIZE=5
SLEEP_WHEN_EMPTY=3
MAX_RETRIES=3

# ============================================================================
# Authentication Configuration
# ============================================================================
# Set to false for development (NEVER in production!)
AUTH_ENABLED=true

# JWT Secret Key - GENERATE A STRONG RANDOM KEY FOR PRODUCTION!
# Run: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_RANDOM_32_BYTE_STRING

# JWT Token expiration in minutes
JWT_EXPIRE_MINUTES=60

# API Key for service-to-service authentication (optional)
# Run: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Admin credentials
ADMIN_USERNAME=admin
# IMPORTANT: Generate password hash using the /api/auth/hash-password endpoint
# Default password is "changeme" - CHANGE THIS IN PRODUCTION!
ADMIN_PASSWORD_HASH=

# ============================================================================
# CORS Configuration
# ============================================================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Set to true to allow all origins (development only!)
CORS_ALLOW_ALL=false

# ============================================================================
# Data Retention Configuration
# ============================================================================
RETENTION_ENABLED=true
RETENTION_DAYS=90
RETENTION_CHECK_HOURS=24

# ============================================================================
# Alerting Configuration
# ============================================================================
ALERTING_ENABLED=false

# Webhook URL for alerts (Slack, Discord, Teams, custom)
ALERT_WEBHOOK_URL=

# Email alerting (requires SMTP configuration)
ALERT_EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=security@example.com,admin@example.com

# Minimum severity to trigger alerts (Low, Medium, High, Critical)
ALERT_SEVERITY_THRESHOLD=High

# ============================================================================
# Monitoring Services Ports
# ============================================================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
DASHBOARDS_PORT=5601
FLUENTD_PORT=24224

# ============================================================================
# Grafana Configuration
# ============================================================================
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ============================================================================
# Nginx Configuration (Production)
# ============================================================================
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ============================================================================
# Example Webhook URL Formats (replace with your actual URLs)
# ============================================================================
# Slack: https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
# Discord: https://discord.com/api/webhooks/YOUR_DISCORD_WEBHOOK
# Teams: https://outlook.office.com/webhook/YOUR_TEAMS_WEBHOOK
# PagerDuty: https://events.pagerduty.com/v2/enqueue
