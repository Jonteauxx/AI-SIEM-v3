# AI-SIEM v3 Configuration
# Copy this file to .env and update with your values

# ==============================================================================
# Elasticsearch/OpenSearch Configuration
# ==============================================================================
ES_HOSTS=http://localhost:9200
ES_INDEX=ai-analyzed-logs

# ==============================================================================
# Ollama LLM Configuration
# ==============================================================================
OLLAMA_URL=http://localhost:11434
# Recommended models: mistral:7b, llama2:7b, codellama:7b
OLLAMA_MODEL=mistral:7b

# ==============================================================================
# Database Configuration
# ==============================================================================
DB_NAME=ai_agent_logs.db

# ==============================================================================
# Network Configuration
# ==============================================================================
# Log ingestion port (FluentD forwards here)
LISTEN_PORT=5046

# API server configuration
HOST_IP=0.0.0.0
API_PORT=8000

# ==============================================================================
# Processing Configuration
# ==============================================================================
# Maximum retry attempts for failed log processing
MAX_RETRIES=3

# ==============================================================================
# Optional: Advanced Configuration
# ==============================================================================
# Batch size for log processing
# BATCH_SIZE=5

# Sleep time when no logs are pending (seconds)
# SLEEP_WHEN_EMPTY=3

# ==============================================================================
# Optional: Production Settings
# ==============================================================================
# Enable if using PostgreSQL instead of SQLite
# DATABASE_URL=postgresql://user:password@localhost:5432/siem

# CORS allowed origins (comma-separated) - Restrict in production!
# CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# Rate limiting configuration
RATE_LIMIT_PER_MINUTE=120
LOGIN_RATE_LIMIT=5/minute

# ==============================================================================
# Optional: Monitoring & Alerting (Future Implementation)
# ==============================================================================
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# EMAIL_SMTP_SERVER=smtp.gmail.com
# EMAIL_SMTP_PORT=587
# EMAIL_FROM=alerts@yourdomain.com
# EMAIL_TO=soc@yourdomain.com
# EMAIL_PASSWORD=your-app-password

# ==============================================================================
# Optional: Freshdesk Integration (Future Implementation)
# ==============================================================================
# FRESHDESK_DOMAIN=yourcompany.freshdesk.com
# FRESHDESK_API_KEY=your-api-key

# ==============================================================================
# Security & Authentication (REQUIRED)
# ==============================================================================
# JWT Secret Key - MUST be changed in production!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=CHANGE-THIS-SECRET-KEY-IN-PRODUCTION-MIN-32-CHARS

# JWT Configuration
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# API Key Header for Service-to-Service Authentication
API_KEY_HEADER=X-API-Key

# Default Admin Credentials (CHANGE IMMEDIATELY AFTER FIRST LOGIN!)
# Username: admin
# Password: changeme

# ==============================================================================
# Logging
# ==============================================================================
# LOG_LEVEL=INFO
# LOG_FILE=soc_agent.log

# ==============================================================================
# Professional Features Configuration
# ==============================================================================
# Default SLA thresholds (in minutes)
# SLA_CRITICAL_MINUTES=15
# SLA_HIGH_MINUTES=60
# SLA_MEDIUM_MINUTES=240
# SLA_LOW_MINUTES=1440

# Enable desktop notifications by default
# ENABLE_DESKTOP_NOTIFICATIONS=false

# Default user role for new users (admin, analyst, manager)
# DEFAULT_USER_ROLE=analyst
